# WanderWise AI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# --- LLM Provider -----------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# --- Web Search --------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# --- API Server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
